#!/bin/bash
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

fail() { printf '%s\n' "$*" >&2; exit 1; }
[ "${3:-/}" = / ] || fail '请安装到当前启动磁盘。'
[ "$(uname -m)" = x86_64 ] || fail '此安装包适用于 Intel Mac。'
os_version=$(sw_vers -productVersion)
os_major=${os_version%%.*}
[ "$os_major" -ge 12 ] || fail '此安装包需要 macOS Monterey 12 或更新系统。'
for process_name in Codex clash-verge; do
    if pgrep -x "$process_name" >/dev/null 2>&1; then
        fail '请先完全退出 Codex 和 Clash Verge，再重新安装。'
    fi
done
free_kb=$(df -k /Applications | awk 'END {print $4}')
[ "$free_kb" -ge 4194304 ] || fail '安装前请至少留出 4 GB 可用空间。'
exit 0
